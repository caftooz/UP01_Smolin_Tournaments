<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Тёмная тема: стили берутся из Dictionary.xaml, здесь заменяются только цвета -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Dictionary.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- Цвета тёмной темы -->
    <Color x:Key="WindowColor">#1E2024</Color>
    <Color x:Key="PanelColor">#25282D</Color>
    <Color x:Key="SurfaceColor">#2A2E34</Color>
    <Color x:Key="SurfaceAltColor">#2E3238</Color>
    <Color x:Key="HoverColor">#353A41</Color>
    <Color x:Key="AccentColor">#9DB5CE</Color>
    <Color x:Key="AccentSoftColor">#36424F</Color>
    <Color x:Key="FocusRingColor">#409DB5CE</Color>
    <Color x:Key="TextColor">#E4E1DB</Color>
    <Color x:Key="MutedColor">#9A9DA3</Color>
    <Color x:Key="LineColor">#373B42</Color>
    <Color x:Key="InputBorderColor">#444951</Color>
    <Color x:Key="ButtonColor">#9DB5CE</Color>
    <Color x:Key="ButtonHoverColor">#AFC3D8</Color>
    <Color x:Key="ButtonPressedColor">#8AA4BF</Color>
    <Color x:Key="ButtonTextColor">#1E2329</Color>
    <Color x:Key="DangerColor">#E39A94</Color>
    <Color x:Key="SuccessColor">#9CC2A5</Color>
    <Color x:Key="WarningColor">#E2C08D</Color>
    <Color x:Key="ScrollThumbColor">#41464E</Color>
    <Color x:Key="ScrollThumbHoverColor">#555B64</Color>
    <Color x:Key="ShadowColor">#000000</Color>

    <SolidColorBrush x:Key="WindowBrush"           Color="{StaticResource WindowColor}"/>
    <SolidColorBrush x:Key="PanelBrush"            Color="{StaticResource PanelColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush"          Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="SurfaceAltBrush"       Color="{StaticResource SurfaceAltColor}"/>
    <SolidColorBrush x:Key="HoverBrush"            Color="{StaticResource HoverColor}"/>
    <SolidColorBrush x:Key="AccentBrush"           Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentSoftBrush"       Color="{StaticResource AccentSoftColor}"/>
    <SolidColorBrush x:Key="FocusRingBrush"        Color="{StaticResource FocusRingColor}"/>
    <SolidColorBrush x:Key="TextBrush"             Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="MutedBrush"            Color="{StaticResource MutedColor}"/>
    <SolidColorBrush x:Key="LineBrush"             Color="{StaticResource LineColor}"/>
    <SolidColorBrush x:Key="InputBorderBrush"      Color="{StaticResource InputBorderColor}"/>
    <SolidColorBrush x:Key="ButtonBrush"           Color="{StaticResource ButtonColor}"/>
    <SolidColorBrush x:Key="ButtonHoverBrush"      Color="{StaticResource ButtonHoverColor}"/>
    <SolidColorBrush x:Key="ButtonPressedBrush"    Color="{StaticResource ButtonPressedColor}"/>
    <SolidColorBrush x:Key="ButtonTextBrush"       Color="{StaticResource ButtonTextColor}"/>
    <SolidColorBrush x:Key="DangerBrush"           Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="SuccessBrush"          Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="WarningBrush"          Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="ScrollThumbBrush"      Color="{StaticResource ScrollThumbColor}"/>
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="{StaticResource ScrollThumbHoverColor}"/>

    <DropShadowEffect x:Key="PopupShadow" BlurRadius="12" ShadowDepth="2" Direction="270"
                      Color="{StaticResource ShadowColor}" Opacity="0.28"/>

    <!-- Системные цвета для стандартных шаблонов WPF -->
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}"              Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}"          Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}"             Color="{StaticResource PanelColor}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}"         Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}"            Color="{StaticResource MutedColor}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"           Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}"       Color="{StaticResource ButtonTextColor}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}"     Color="{StaticResource AccentSoftColor}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}"                Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}"            Color="{StaticResource TextColor}"/>
</ResourceDictionary>
