                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CalendarHeaderButton" TargetType="Button" BasedOn="{StaticResource CalendarNavButton}">
        <Setter Property="Width" Value="Auto"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="AppCalendarDayButton" TargetType="CalendarDayButton">
        <Setter Property="MinWidth" Value="34"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Margin" Value="1"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CalendarDayButton">
                    <Grid>
                        <Border x:Name="Bd" CornerRadius="8" Background="Transparent" BorderBrush="Transparent"
                                BorderThickness="1.5"/>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4,2">
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock"/>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
