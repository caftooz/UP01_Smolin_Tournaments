<Window x:Class="UP01_Smolin_Tournaments.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UP01_Smolin_Tournaments"
        mc:Ignorable="d"
        Title="MainWindow" Height="800" Width="1250" MinHeight="560" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded" Closing="Window_Closing"
        Background="{DynamicResource WindowBrush}" FontFamily="{DynamicResource AppFont}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="45"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="45"/>
        </Grid.RowDefinitions>

        <DockPanel Background="{DynamicResource PanelBrush}" LastChildFill="False">
            <Image Source="/res/logo.png" Height="37" Margin="10,4,5,4" RenderOptions.BitmapScalingMode="HighQuality"
                   ToolTip="Платформа организации киберспортивных турниров"/>
            <Button x:Name="BtnBack" Content="Назад" ToolTip="Вернуться на предыдущую страницу" Click="BtnBack_Click"/>
            <Button x:Name="BtnTheme" Content="Сменить тему" ToolTip="Переключить светлую / тёмную тему" Click="BtnTheme_Click"/>
            <Button x:Name="BtnLogout" Content="Выйти" ToolTip="Выйти из учётной записи" Click="BtnLogout_Click"/>
            <Button x:Name="BtnChangePass" DockPanel.Dock="Right" Content="Сменить пароль"
                    ToolTip="Сменить пароль учётной записи" Click="BtnChangePass_Click"/>
        </DockPanel>
        
        <Frame x:Name="MainFrame" Grid.Row="1" NavigationUIVisibility="Hidden" Navigated="MainFrame_Navigated"/>

        <Grid Grid.Row="2" Background="{DynamicResource PanelBrush}">
            <TextBlock x:Name="UserInfo" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0"/>
            <TextBlock x:Name="DateTimeNow" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/>
        </Grid>

    </Grid>
</Window>
