<Page x:Class="UP01_Smolin_Tournaments.Pages.AddTournamentPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:UP01_Smolin_Tournaments.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Турнир"
      Loaded="Page_Loaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Width="480" HorizontalAlignment="Center" Margin="0,10,0,20">
            <TextBlock x:Name="TbHeader" Style="{StaticResource HeaderText}"/>
            <TextBlock Text="* — обязательные поля" Margin="5,0,5,8" Foreground="{DynamicResource MutedBrush}"/>

            <TextBlock Text="Название *" Margin="5,8,5,0"/>
            <Grid>
                <TextBox x:Name="TbName" MaxLength="150" ToolTip="Название турнира: от 3 до 150 символов"
                         Tag="{Binding ElementName=PhName}"/>
                <TextBlock x:Name="PhName" Text="Например: Кубок клуба по Dota 2" Style="{StaticResource Placeholder}"/>
            </Grid>

            <TextBlock Text="Дисциплина *" Margin="5,8,5,0"/>
            <ComboBox x:Name="CbDiscipline" DisplayMemberPath="Name" SelectedValuePath="DisciplineID"
                      ToolTip="Киберспортивная дисциплина турнира"/>

            <TextBlock Text="Формат розыгрыша *" Margin="5,8,5,0"/>
            <ComboBox x:Name="CbFormat" DisplayMemberPath="Name" SelectedValuePath="TournamentFormatID"
                      ToolTip="Турнирная система: олимпийская, двойное выбывание, круговая, швейцарская"/>

            <TextBlock Text="Статус *" Margin="5,8,5,0"/>
            <ComboBox x:Name="CbStatus" DisplayMemberPath="Name" SelectedValuePath="TournamentStatusID"
                      ToolTip="Этап жизненного цикла турнира"/>

            <TextBlock Text="Организатор *" Margin="5,8,5,0"/>
            <ComboBox x:Name="CbOrganizer" DisplayMemberPath="FullName" SelectedValuePath="UserID"
                      ToolTip="Активный пользователь с ролью «Организатор» или «Администратор»"/>

            <CheckBox x:Name="ChkOnline" Content="Онлайн-турнир (площадка не нужна)" Margin="5,10,5,0"
                      ToolTip="Отметьте, если турнир проводится через интернет"
                      Checked="ChkOnline_Changed" Unchecked="ChkOnline_Changed"/>

            <TextBlock Text="Площадка (для офлайн-турнира) *" Margin="5,8,5,0"/>
            <ComboBox x:Name="CbVenue" DisplayMemberPath="Name" SelectedValuePath="VenueID"
                      ToolTip="Где проходят офлайн-матчи"/>

            <TextBlock Text="Начало регистрации *" Margin="5,8,5,0"/>
            <DatePicker x:Name="DpRegStart" ToolTip="С этой даты команды подают заявки"/>

            <TextBlock Text="Окончание регистрации *" Margin="5,8,5,0"/>
            <DatePicker x:Name="DpRegEnd" ToolTip="Не раньше начала регистрации и не позже старта турнира"/>

            <TextBlock Text="Дата и время начала *" Margin="5,8,5,0"/>
            <StackPanel Orientation="Horizontal">
                <DatePicker x:Name="DpStart" Width="300" ToolTip="Дата первого матча"/>
                <Grid Width="160">
                    <TextBox x:Name="TbStartTime" MaxLength="5" ToolTip="Время начала в формате чч:мм, например 18:30"
                             Tag="{Binding ElementName=PhStartTime}"/>
                    <TextBlock x:Name="PhStartTime" Text="чч:мм" Style="{StaticResource Placeholder}"/>
                </Grid>
            </StackPanel>

            <TextBlock Text="Дата окончания" Margin="5,8,5,0"/>
            <DatePicker x:Name="DpEnd" ToolTip="Необязательно; не раньше даты начала"/>

            <TextBlock Text="Максимум команд * (от 2 до 128)" Margin="5,8,5,0"/>
            <Grid>
                <TextBox x:Name="TbMaxTeams" MaxLength="3" ToolTip="Целое число от 2 до 128"
                         Tag="{Binding ElementName=PhMaxTeams}"/>
                <TextBlock x:Name="PhMaxTeams" Text="Например: 16" Style="{StaticResource Placeholder}"/>
            </Grid>

            <TextBlock Text="Взнос с команды, ₽ * (от 0 до 100 000)" Margin="5,8,5,0"/>
            <Grid>
                <TextBox x:Name="TbFee" MaxLength="10" ToolTip="Сумма в рублях; 0 — бесплатное участие"
                         Tag="{Binding ElementName=PhFee}"/>
                <TextBlock x:Name="PhFee" Text="Например: 500" Style="{StaticResource Placeholder}"/>
            </Grid>

            <TextBlock Text="Призовой фонд, ₽ * (от 0 до 10 000 000)" Margin="5,8,5,0"/>
            <Grid>
                <TextBox x:Name="TbPrize" MaxLength="12" ToolTip="Общая сумма призов в рублях"
                         Tag="{Binding ElementName=PhPrize}"/>
                <TextBlock x:Name="PhPrize" Text="Например: 20000" Style="{StaticResource Placeholder}"/>
            </Grid>

            <TextBlock Text="Описание" Margin="5,8,5,0"/>
            <Grid>
                <TextBox x:Name="TbDescription" Height="70" MaxLength="1000" TextWrapping="Wrap" AcceptsReturn="True"
                         VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"
                         ToolTip="Кратко о турнире, до 1000 символов" Tag="{Binding ElementName=PhDescription}"/>
                <TextBlock x:Name="PhDescription" Text="Для кого турнир, что разыгрывается" Style="{StaticResource Placeholder}"
                           VerticalAlignment="Top" Margin="13,10,0,0"/>
            </Grid>

            <TextBlock Text="Регламент" Margin="5,8,5,0"/>
            <Grid>
                <TextBox x:Name="TbRules" Height="70" MaxLength="4000" TextWrapping="Wrap" AcceptsReturn="True"
                         VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"
                         ToolTip="Правила проведения, до 4000 символов" Tag="{Binding ElementName=PhRules}"/>
                <TextBlock x:Name="PhRules" Text="Например: серии BO3, финал BO5" Style="{StaticResource Placeholder}"
                           VerticalAlignment="Top" Margin="13,10,0,0"/>
            </Grid>

            <WrapPanel HorizontalAlignment="Center" Margin="0,12,0,0">
                <Button Content="Сохранить" ToolTip="Проверить данные и сохранить турнир" IsDefault="True" Click="BtnSave_Click"/>
                <Button Content="Отмена" ToolTip="Вернуться без сохранения" Click="BtnCancel_Click"/>
            </WrapPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
