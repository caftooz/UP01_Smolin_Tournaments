<Page x:Class="UP01_Smolin_Tournaments.Pages.ChangePassPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:UP01_Smolin_Tournaments.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Смена пароля">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="320" Margin="0,20">
            <TextBlock Text="Смена пароля" Style="{StaticResource HeaderText}"/>

            <Grid>
                <TextBox x:Name="TbLogin" MaxLength="50" ToolTip="Логин учётной записи"
                         Tag="{Binding ElementName=PhLogin}"/>
                <TextBlock x:Name="PhLogin" Text="Логин" Style="{StaticResource Placeholder}"/>
            </Grid>
            <Grid>
                <PasswordBox x:Name="PbOld" MaxLength="50" ToolTip="Пароль, которым вы входите сейчас"
                             Tag="{Binding ElementName=PhOld}"/>
                <TextBlock x:Name="PhOld" Text="Текущий пароль" Style="{StaticResource Placeholder}"/>
            </Grid>
            <Grid>
                <PasswordBox x:Name="PbNew" MaxLength="50" ToolTip="От 6 символов, латиница, хотя бы одна цифра"
                             Tag="{Binding ElementName=PhNew}"/>
                <TextBlock x:Name="PhNew" Text="Новый пароль" Style="{StaticResource Placeholder}"/>
            </Grid>
            <Grid>
                <PasswordBox x:Name="PbNew2" MaxLength="50" ToolTip="Введите новый пароль ещё раз"
                             Tag="{Binding ElementName=PhNew2}"/>
                <TextBlock x:Name="PhNew2" Text="Повторите новый пароль" Style="{StaticResource Placeholder}"/>
            </Grid>

            <Button Content="Сохранить" ToolTip="Сохранить новый пароль" IsDefault="True" Click="BtnSave_Click"/>
        </StackPanel>
    </ScrollViewer>
</Page>
