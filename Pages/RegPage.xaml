<Page x:Class="UP01_Smolin_Tournaments.Pages.RegPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:UP01_Smolin_Tournaments.Pages"
      xmlns:h="clr-namespace:UP01_Smolin_Tournaments.Helpers"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Регистрация">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="320" Margin="0,20">
            <TextBlock Text="Регистрация" Style="{StaticResource HeaderText}"/>

            <TextBox x:Name="TbLogin" MaxLength="50"
                     ToolTip="Логин: 3–50 символов, латиница, цифры, _" h:Field.Hint="Введите логин" h:Field.Mask="Login"/>
            <TextBox x:Name="TbFio" MaxLength="150"
                     ToolTip="Фамилия Имя Отчество русскими буквами" h:Field.Hint="Введите ФИО" h:Field.Mask="FullName"/>
            <PasswordBox x:Name="PbPass" MaxLength="50"
                         ToolTip="От 8 символов, латиница, хотя бы одна цифра" h:Field.Hint="Введите пароль"/>
            <PasswordBox x:Name="PbPass2" MaxLength="50" ToolTip="Повторите пароль" h:Field.Hint="Повторите пароль"/>

            <TextBlock Text="Роль" Style="{StaticResource FieldLabel}"/>
            <ComboBox x:Name="CbRole" SelectedIndex="0" ToolTip="Выберите роль">
                <ComboBoxItem Content="Игрок" Tag="Игрок"/>
                <ComboBoxItem Content="Администратор" Tag="Администратор"/>
            </ComboBox>

            <Button Content="Создать аккаунт" ToolTip="Зарегистрироваться" Click="BtnReg_Click"/>
        </StackPanel>
    </ScrollViewer>
</Page>
