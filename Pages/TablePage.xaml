<Page x:Class="UP01_Smolin_Tournaments.Pages.TablePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:UP01_Smolin_Tournaments.Pages"
      xmlns:h="clr-namespace:UP01_Smolin_Tournaments.Helpers"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Таблица"
      IsVisibleChanged="Page_IsVisibleChanged">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <WrapPanel>
            <TextBox x:Name="TbSearch" Width="290" MaxLength="100" h:Field.Hint="Поиск…" TextChanged="TbSearch_TextChanged"
                     ToolTip="Поиск по текстовым полям и названиям связанных записей"/>
            <Button Content="Добавить" ToolTip="Добавить новую запись" Click="BtnAdd_Click"/>
            <Button Content="Изменить" ToolTip="Изменить выделенную запись (или двойной щелчок по строке)" Click="BtnEdit_Click"/>
            <Button Content="Удалить" ToolTip="Удалить выделенные записи (можно выделить несколько с Ctrl или Shift)" Click="BtnDelete_Click"/>
        </WrapPanel>

        <DataGrid x:Name="GridItems" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Extended" MouseDoubleClick="GridItems_MouseDoubleClick"/>

        <TextBlock x:Name="TbCount" Grid.Row="2" Margin="5" Foreground="{DynamicResource MutedBrush}"/>
    </Grid>
</Page>
